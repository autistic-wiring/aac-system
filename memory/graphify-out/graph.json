    {
      "id": "kiosk_mode_charging_dim",
      "label": "Charging Aware Idle Dim",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "Kiosk Shell And Power",
      "contributor": null,
      "file_type": "concept",
      "norm_label": "charging aware idle dim",
      "rationale": "navigator.getBattery returns stale state inside the WebView so the board dimmed on the charger; NativeBridge.isCharging reads the battery broadcast with a 5s poll fallback, overlay opacity is derived so dim state survives charger connects, and the 2026-10-04 change dims to 60 percent brightness instead of near-black.",
      "source_file": "kiosk-mode.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "kiosk_mode_kiosk_layers",
      "label": "Kiosk Mode Layers",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "Kiosk Shell And Power",
      "contributor": null,
      "file_type": "concept",
      "norm_label": "kiosk mode layers",
      "rationale": "Web layer re-enters fullscreen, blocks exit gestures, and traps history back with a 3s caregiver exit hold; Android shell adds immersive sticky bars, consumes hardware back, and uses lock task when provisioned as device owner.",
      "source_file": "kiosk-mode.md",
      "source_location": null,
      "source_url": null
    },
